{
  "compilerOptions": {
    "baseUrl": ".",
    "isolatedModules": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "destinations/*": [
        "nft-event-generator/src/destinations/*"
      ],
      "generators/*": [
        "nft-event-generator/src/generators/*"
      ],
      "jest": [
        "../../../node_modules/jest"
      ],
      "utils": [
        "nft-event-generator/src/utils/index.ts"
      ],
      "utils/*": [
        "nft-event-generator/src/utils/*"
      ]
    }
  },
  "exclude": [
    "node_modules"
  ],
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "./**/*"
  ]
}
